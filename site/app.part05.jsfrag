
function bind(){$$(".nav-link,[data-view]").forEach(b=>b.addEventListener("click",e=>{if(b.dataset.view){e.preventDefault();show(b.dataset.view)}}));$("#mobile-menu").onclick=()=>$("#main-nav").classList.toggle("open");$("#hero-search").oninput=renderHeroes;$("#role-filters").onclick=e=>{let b=e.target.closest("[data-role]");if(!b)return;roleFilter=b.dataset.role;$ $("[data-role]").forEach(x=>x.classList.toggle("active",x===b));renderHeroes()};$("#lane-filters").onclick=e=>{let b=e.target.closest("[data-lane]");if(!b)return;laneFilter=b.dataset.lane;$$("[data-lane]").forEach(x=>x.classList.toggle("active",x===b));renderHeroes()};$("#fav-filter").onclick=()=>{favOnly=!favOnly;$("#fav-filter").classList.toggle("active",favOnly);$("#fav-filter").textContent=favOnly?"★ Избранное":"☆ Избранное";renderHeroes()};$("#hero-grid").onclick=e=>{let f=e.target.closest("[data-fav]");if(f){e.stopPropagation();toggleFav(f.dataset.fav);return}let c=e.target.closest("[data-hero]");if(c)openHero(c.dataset.hero)};$("#hero-grid").onkeydown=e=>{if(e.key==="Enter"&&e.target.dataset.hero)openHero(e.target.dataset.hero)};$("#item-search").oninput=renderItems;$("#item-filters").onclick=e=>{let b=e.target.closest("[data-cat]");if(!b)return;itemCat=b.dataset.cat;$$("[data-cat]").forEach(x=>x.classList.toggle("active",x===b));renderItems()};$("#save-build").onclick=saveBuild;$("#build-slots").onchange=buildPreview;$("#build-emblem").onchange=buildPreview;$("#saved-builds").onclick=e=>{let l=e.target.closest("[data-load]"),d=e.target.closest("[data-del]");if(l)loadBuild(Number(l.dataset.load));if(d){builds=builds.filter(x=>x.id!==Number(d.dataset.del));write(K.build,builds);renderBuilds()}};$("#compare-a").onchange=renderCompare;$("#compare-b").onchange=renderCompare;$("#tier-add").onclick=addTier;$("#tier-clear").onclick=()=>{if(confirm("Очистить личный тир-лист?")){tiers={S:[],A:[],B:[],C:[],D:[]};write(K.tier,tiers);renderTier()}};$("#tier-board").onclick=e=>{let b=e.target.closest("[data-tier-remove]");if(!b)return;let [t,k]=b.dataset.tierRemove.split("|");tiers[t]=tiers[t].filter(x=>x!==k);write(K.tier,tiers);renderTier()};$("#run-calc").onclick=calculate;$("#library-content").onclick=e=>{let b=e.target.closest("[data-library]");if(!b)return;library=b.dataset.library;$$("[data-library]").forEach(x=>x.classList.toggle("active",x===b));renderLibrary()};$("#modal").onclick=e=>{if(e.target.matches("[data-close]"))closeModal()};document.addEventListener("keydown",e=>{if(e.key==="Escape")closeModal()})}
if("serviceWorker"in navigator)window.addEventListener("load",()=>navigator.serviceWorker.register("./sw.js").catch(()=>{}));load();
