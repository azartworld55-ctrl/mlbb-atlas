
function loadBuild(n){let b=builds.find(x=>x.id===n);if(!b)return;$("#build-name").value=b.name;$("#build-hero").value=b.hero;$$(".build-item").forEach((x,i)=>x.value=b.items[i]||"");$("#build-emblem").value=b.emblem||"";$("#build-spell").value=b.spell||"";buildPreview();toast("Сборка загружена")}
function renderCompare(){let a=hero($("#compare-a").value),b=hero($("#compare-b").value);if(!a||!b)return;let card=h=>{let p=DB.skills.filter(x=>x.hero_id===id(h)||x.hero_id===h.id);return '<article class="compare-card"><h3>'+esc(displayName(h))+'</h3><p>'+esc((h.roles||[]).map(role).join(" · "))+'</p><p>Линии: '+esc((h.lanes||[]).map(lane).join(" / "))+'</p><b>Навыки: '+(h.skills||[]).length+'</b><ul>'+(h.skills||[]).map(s=>'<li>'+esc(s.name_ru||s.name)+' — '+esc(s.type)+'</li>').join("")+'</ul><b>Записей патчей: '+p.length+'</b><p class="muted">'+esc(status(h.provenance?.confidence))+'</p></article>'};$("#compare-result").innerHTML=card(a)+card(b)}
function renderTier(){$("#tier-board").innerHTML=["S","A","B","C","D"].map(t=>'<div class="tier-row"><div class="tier-label">'+t+'</div><div class="tier-members">'+((tiers[t]||[]).map(k=>hero(k)?'<span class="tier-member">'+esc(displayName(hero(k)))+' <button data-tier-remove="'+t+'|'+esc(k)+'">×</button></span>':"").join("")||'<span class="muted">Пока пусто</span>')+'</div></div>').join("")}
function addTier(){let k=$("#tier-hero").value,t=$("#tier-rank").value;if(!k){toast("Выбери героя");return}Object.keys(tiers).forEach(x=>tiers[x]=tiers[x].filter(y=>y!==k));tiers[t].push(k);write(K.tier,tiers);renderTier()}
function renderLibrary(){let host=$("#library-content");if(library==="emblems")host.innerHTML='<div class="library-list">'+DB.emblems.map(x=>'<article class="library-card"><div class="item-category">ЭМБЛЕМА · '+esc(x.role||"")+'</div><h3>'+esc(displayName(x))+'</h3><div class="stat-chips">'+chips(mods(x.modifiers))+'</div><p>'+esc(x.provenance?.notes||"")+'</p><small class="muted">'+esc(status(x.provenance?.confidence))+'</small>'+(source(x)?'<br><a class="source-link" href="'+esc(source(x))+'" target="_blank" rel="noopener">Источник ↗</a>':"")+'</article>').join("")+'</div>';
else if(library==="spells")host.innerHTML='<div class="library-list">'+DB.spells.map(x=>'<article class="library-card"><div class="item-category">БОЕВОЕ ЗАКЛИНАНИЕ</div><h3>'+esc(displayName(x))+'</h3><p>'+esc(displayText(x,"summary")||"Описание отсутствует.")+'</p><div class="item-cost">Перезарядка: '+esc(x.cooldown_seconds??"—")+' сек.</div><small class="muted">'+esc(x.provenance?.notes||"")+'</small>'+(source(x)?'<br><a class="source-link" href="'+esc(source(x))+'" target="_blank" rel="noopener">Источник ↗</a>':"")+'</article>').join("")+'</div>';
else if(library==="skills"){host.innerHTML='<div class="toolbar"><label class="searchbox">⌕<input id="skill-q" placeholder="Герой, навык или патч"></label><select id="skill-status" class="field"><option value="all">Все статусы</option><option value="verified">Проверено</option><option value="reported">Сообщено источником</option><option value="experimental">Экспериментально</option></select></div><div id="skill-list" class="skill-list"></div>';$("#skill-q").oninput=renderSkills;$("#skill-status").onchange=renderSkills;renderSkills()}
else host.innerHTML='<div class="panel"><h3>MLBB ATLAS</h3><p>Независимый фанатский справочник, не связанный с Moonton. Игровые материалы принадлежат правообладателям.</p><p>Герои и предметы импортированы из <a class="source-link" href="https://github.com/p3hndrx/MLBB-API" target="_blank" rel="noopener">p3hndrx/MLBB-API</a> (MIT; ревизии указаны в данных). Записи патчей перенесены из community mirrors и не подтверждены непосредственно в клиенте.</p><p>'+DB.heroes.length+' героев · '+DB.items.length+' предметов · '+DB.emblems.length+' эмблем · '+DB.spells.length+' заклинаний · '+DB.skills.length+' записей навыков.</p><p>Избранное, сборки и личный тир-лист хранятся только в localStorage браузера.</p><a class="source-link" href="https://github.com/azartworld55-ctrl/mlbb-atlas" target="_blank" rel="noopener">Репозиторий ↗</a> · <a class="source-link" href="https://github.com/azartworld55-ctrl/mlbb-atlas/blob/main/THIRD_PARTY_NOTICES.md" target="_blank" rel="noopener">Лицензии ↗</a></div>'}
function renderSkills(){let q=($("#skill-q")?.value||"").toLowerCase(),st=$("#skill-status")?.value||"all",rows=DB.skills.filter(x=>(st==="all"||x.verification?.status===st)&&[x.hero_id,x.skill_name,x.skill_name_ru,displayName(hero(x.hero_id)),x.patch?.version].join(" ").toLowerCase().includes(q));$("#skill-list").innerHTML=rows.map(x=>'<article class="skill-card"><div class="skill-head"><div><h3>'+esc(x.skill_name_ru||x.skill_name)+' · '+esc(x.hero_id)+'</h3><div class="skill-meta">Патч '+esc(x.patch?.version)+' · '+esc(x.patch?.channel)+' · '+esc(x.patch?.effective_from||"дата не указана")+'</div></div><span class="status-tag '+esc(x.verification?.status)+'">'+esc(status(x.verification?.status))+'</span></div><div class="skill-parameters">'+(x.parameters||[]).map(p=>'<span class="parameter">'+esc(p.key)+': '+esc((p.values_by_skill_level||[]).join(" → ")||"не опубликовано")+' '+esc(p.unit||"")+' · '+esc(p.value_semantics||"")+'</span>').join("")+'</div><p class="skill-meta">'+esc(x.verification?.notes||"")+'</p>'+(x.sources?.[0]?.url?'<a class="source-link" href="'+esc(x.sources[0].url)+'" target="_blank" rel="noopener">Источник ↗</a>':"")+'</article>').join("")||'<div class="empty-state">Записей не найдено.</div>'}
