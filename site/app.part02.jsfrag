
function toggleFav(k){fav.has(k)?fav.delete(k):fav.add(k);write(K.fav,[...fav]);renderHeroes()}
function openHero(k,fromHash=false){let h=hero(k);if(!h)return;if(!fromHash&&location.hash!=="#hero="+encodeURIComponent(k))history.pushState({...((history.state)||{}),atlasHero:k},"","#hero="+encodeURIComponent(k));let rec=DB.skills.filter(x=>x.hero_id===k||x.hero_id===h.id),src=source(h);$("#modal-content").innerHTML='<div class="modal-hero">'+(h.assets?.portrait_url?'<img class="modal-portrait" src="'+esc(h.assets.portrait_url)+'" alt="">':'<div class="modal-portrait"></div>')+'<div><div class="overline">КАРТОЧКА ГЕРОЯ</div><h2>'+esc(displayName(h))+'</h2><p>'+esc((h.roles||[]).map(role).join(" · "))+'</p><p>Линии: '+esc((h.lanes||[]).map(lane).join(" / ")||"не указаны")+'</p><span class="status-tag">'+esc(status(h.provenance?.confidence))+'</span><div class="modal-actions"><button id="mfav">'+(fav.has(k)?"★ В избранном":"☆ В избранное")+'</button><button id="mbuild">Создать сборку</button><button id="mcompare">Сравнить</button><button id="mshare">Скопировать ссылку</button></div></div></div><h3>СПОСОБНОСТИ</h3>'+((h.skills||[]).map(s=>'<div class="modal-skill"><b>'+esc(s.name_ru||s.name)+' <small class="muted">· '+esc(s.type)+'</small></b><p>'+esc(s.description_ru||s.description||"Описание отсутствует.")+'</p>'+(s.cooldown&&s.cooldown!=="null"?'<small class="muted">Перезарядка: '+esc(s.cooldown)+' сек.</small>':"")+'</div>').join("")||'<p class="muted">Нет данных.</p>')+'<h3>ЗАПИСИ ПО ПАТЧАМ ('+rec.length+')</h3>'+rec.map(x=>'<div class="skill-meta">'+esc(x.skill_name)+' · '+esc(x.patch?.version)+' · '+esc(status(x.verification?.status))+'</div>').join("")+(src?'<a class="source-link" href="'+esc(src)+'" target="_blank" rel="noopener">Источник каталога ↗</a>':"");$("#modal").classList.remove("hidden");$("#mfav").onclick=()=>{toggleFav(k);$("#mfav").textContent=fav.has(k)?"★ В избранном":"☆ В избранное"};$("#mbuild").onclick=()=>{closeModal();show("builds");$("#build-hero").value=k};$("#mcompare").onclick=()=>{closeModal();show("compare");$("#compare-a").value=k;renderCompare()};$("#mshare").onclick=()=>copyHeroLink(k)}
function closeModal(updateHistory=true){$("#modal").classList.add("hidden");if(updateHistory&&location.hash.startsWith("#hero=")){if(history.state?.atlasHero)history.back();else history.replaceState(history.state,"",location.pathname+location.search)}}
function heroFromHash(){if(!location.hash.startsWith("#hero="))return "";try{return decodeURIComponent(location.hash.slice(6))}catch{return ""}}
async function copyHeroLink(k){const url=new URL(location.href);url.hash="hero="+encodeURIComponent(k);try{await navigator.clipboard.writeText(url.href);toast("Ссылка на героя скопирована")}catch{const field=document.createElement("textarea");field.value=url.href;field.setAttribute("readonly","");field.style.position="fixed";field.style.opacity="0";document.body.append(field);field.select();let copied=false;try{copied=document.execCommand("copy")}catch{}field.remove();toast(copied?"Ссылка на героя скопирована":"Не удалось скопировать ссылку")}}
function renderItems(){let q=$("#item-search").value.toLocaleLowerCase("ru"),rows=DB.items.filter(x=>(itemCat==="all"||x.category===itemCat)&&[x.name,x.name_ru,x.category,x.summary,x.summary_ru,x.description_ru,...(x.unique_passive||[]).map(p=>p.description)].join(" ").toLocaleLowerCase("ru").includes(q));$("#item-count").textContent=rows.length+" / "+DB.items.length;$("#item-grid").innerHTML=rows.map(x=>'<article class="item-card"><div class="item-category">'+esc(C[x.category]||x.category)+'</div><h3>'+esc(displayName(x))+'</h3><div class="item-cost">'+esc(x.cost||"—")+' золота</div><p>'+esc(displayText(x,"summary")||"Описание не указано.")+'</p>'+(x.description_ru?'<p>'+esc(x.description_ru).replaceAll("\\n","<br>")+'</p>':"") + '<div class="stat-chips">'+chips(mods(x.modifiers))+'</div>'+(x.description_ru?"":(x.unique_passive||[]).filter(p=>p.description&&p.description!=="null").map(p=>'<p><b>'+esc(p.unique_passive_name_ru||p.unique_passive_name||"Пассивный эффект")+':</b> '+esc(p.description_ru||p.description)+'</p>').join(""))+'<small class="muted">'+esc(status(x.provenance?.confidence))+'</small>'+(source(x)?'<br><a class="source-link" href="'+esc(source(x))+'" target="_blank" rel="noopener">Источник ↗</a>':"")+'</article>').join("")||'<div class="empty-state">Предметы не найдены.</div>'}
function selectOptions(arr,first){return first+arr.map(x=>'<option value="'+esc(x.slug||x.id)+'">'+esc(displayName(x))+'</option>').join("")}
function initSelects(){let hs=selectOptions([...DB.heroes].sort((a,b)=>displayName(a).localeCompare(displayName(b),"ru")),'<option value="">Выбери героя</option>');["build-hero","compare-a","compare-b","tier-hero"].forEach(k=>$("#"+k).innerHTML=hs);$("#compare-b").selectedIndex=Math.min(2,DB.heroes.length);$("#build-emblem").innerHTML=selectOptions(DB.emblems,'<option value="">Без эмблемы</option>');$("#build-spell").innerHTML=selectOptions(DB.spells,'<option value="">Без заклинания</option>');$("#build-slots").innerHTML=Array.from({length:6},(_,i)=>'<label class="field">Слот '+(i+1)+'<select class="build-item"><option value="">Пусто</option>'+DB.items.map(x=>'<option value="'+esc(x.id)+'">'+esc(displayName(x))+'</option>').join("")+'</select></label>').join("")}
function buildPreview(){let m={};$$(".build-item").map(x=>x.value).filter(Boolean).forEach(k=>Object.entries(mods(item(k)?.modifiers)).forEach(([a,b])=>m[a]=(m[a]||0)+b));let e=DB.emblems.find(x=>(x.slug||x.id)===$("#build-emblem").value);Object.entries(mods(e?.modifiers)).forEach(([a,b])=>m[a]=(m[a]||0)+b);$("#build-preview").textContent="Сумма модификаторов: "+(Object.entries(m).map(([a,b])=>a+": +"+b).join(" · ")||"нет числовых значений")+". Пассивки не симулируются."}
function saveBuild(){let h=$("#build-hero").value;if(!h){toast("Выбери героя");return}builds.unshift({id:Date.now(),name:$("#build-name").value.trim()||"Сборка "+(builds.length+1),hero:h,items:$$(".build-item").map(x=>x.value).filter(Boolean).slice(0,6),emblem:$("#build-emblem").value,spell:$("#build-spell").value});write(K.build,builds);renderBuilds();toast("Сборка сохранена на устройстве")}
function renderBuilds(){$("#saved-builds").innerHTML=builds.map(b=>'<div class="saved-build"><div><strong>'+esc(b.name)+'</strong><small>'+esc(hero(b.hero)?.name||"Герой")+' · '+b.items.length+' предметов</small></div><div><button data-load="'+b.id+'">Загрузить</button> <button data-del="'+b.id+'">Удалить</button></div></div>').join("")||'<p class="muted">Сохранённых сборок пока нет.</p>'}
