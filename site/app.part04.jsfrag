
function sideForm(p){let fields=[["pa","Физ. атака"],["mp","Маг. сила"],["pd","Физ. защита"],["md","Маг. защита"],["hp","HP"],["pp","Пробивание физ. %"],["pf","Пробивание физ. ед."],["mpct","Пробивание маг. %"],["mf","Пробивание маг. ед."],["pdrp","Снижение физ. защиты %"],["pdrf","Снижение физ. защиты ед."],["mdrp","Снижение маг. защиты %"],["mdrf","Снижение маг. защиты ед."],["dr","Снижение урона %"]];return '<label class="field wide">Герой<select id="'+p+'-hero">'+DB.heroes.map(h=>'<option value="'+esc(id(h))+'">'+esc(h.name)+'</option>').join("")+'</select></label>'+fields.map(x=>'<label class="field">'+x[1]+'<input id="'+p+'-'+x[0]+'" type="number" value="0" min="0"></label>').join("")+'<label class="field wide">Предметы (до 6)<select id="'+p+'-items" multiple size="5">'+DB.items.map(x=>'<option value="'+esc(x.id)+'">'+esc(x.name)+'</option>').join("")+'</select></label><label class="field">Эмблема<select id="'+p+'-emblem"><option value="">Нет</option>'+DB.emblems.map(x=>'<option value="'+esc(x.id)+'">'+esc(x.name)+'</option>').join("")+'</select></label><label class="field">Заклинание<select id="'+p+'-spell"><option value="">Нет</option>'+DB.spells.map(x=>'<option value="'+esc(x.id)+'">'+esc(x.name)+'</option>').join("")+'</select></label><div class="wide"><label class="checkline"><input type="checkbox" id="'+p+'-blue"> Синий бафф (без числового эффекта)</label><label class="checkline"><input type="checkbox" id="'+p+'-red"> Красный бафф (без числового эффекта)</label></div>'}
function initCalc(){$("#attacker-form").innerHTML=sideForm("attacker");$("#defender-form").innerHTML=sideForm("defender");$("#attacker-hero").onchange=skillOptions;skillOptions()}
function skillOptions(){let k=$("#attacker-hero")?.value||"",h=hero(k),rows=DB.skills.filter(x=>x.hero_id===k||x.hero_id===h?.id);$("#calc-skill").innerHTML='<option value="">Выбери запись навыка</option>'+rows.map(x=>'<option value="'+esc(x.record_id)+'">'+esc(x.skill_name)+' · '+esc(x.patch?.version)+' · '+esc(status(x.verification?.status))+'</option>').join("")}
function side(p){let v=k=>Number($("#"+p+"-"+k).value)||0,items=[...$("#"+p+"-items").selectedOptions].slice(0,6).map(x=>item(x.value)).filter(Boolean),em=DB.emblems.find(x=>x.id===$("#"+p+"-emblem").value),stats={physical_attack:v("pa"),magic_power:v("mp"),hp:v("hp"),physical_defense:v("pd"),magic_defense:v("md")};[...items,em].filter(Boolean).forEach(x=>Object.entries(mods(x.modifiers)).forEach(([k,n])=>stats[k]=(stats[k]||0)+n));return {hero:hero($("#"+p+"-hero").value),stats,inputs:{pp:v("pp"),pf:v("pf"),mpct:v("mpct"),mf:v("mf"),pdrp:v("pdrp"),pdrf:v("pdrf"),mdrp:v("mdrp"),mdrf:v("mdrf"),dr:v("dr")}}}
function calculate(){let a=side("attacker"),d=side("defender"),r=DB.skills.find(x=>x.record_id===$("#calc-skill").value);if(!a.hero||!d.hero||!r){toast("Выбери обоих героев и запись навыка");return}if(r.hero_id!==a.hero.slug&&r.hero_id!==a.hero.id){toast("Запись навыка не принадлежит атакующему");return}let pars=r.parameters||[],base=pars.filter(p=>p.kind==="base_damage"&&p.values_by_skill_level?.length),scale=pars.filter(p=>p.kind==="scaling"&&p.values_by_skill_level?.length),end=$("#endpoint").value,idx=p=>end==="low"?0:p.values_by_skill_level.length-1,unsupported=scale.some(p=>!["physical_attack","magic_power","max_hp"].includes(p.scaling_attribute));if(base.length!==1||scale.length>1||unsupported){$("#calc-result").innerHTML='<b>Итоговый урон не рассчитан.</b><div class="result-detail">У записи несколько компонентов или коэффициентов либо нет отдельного базового урона. Доступные значения:</div><div class="skill-parameters">'+pars.map(p=>'<span class="parameter">'+esc(p.key)+': '+esc((p.values_by_skill_level||[]).join(" → "))+' '+esc(p.unit||"")+'</span>').join("")+'</div>';return}let raw=Number(base[0].values_by_skill_level[idx(base[0])]);if(scale.length){let p=scale[0],key={physical_attack:"physical_attack",magic_power:"magic_power",max_hp:"hp"}[p.scaling_attribute];raw+=(a.stats[key]||0)*Number(p.values_by_skill_level[idx(p)])/100}let type=$("#damage-type").value,eff=0,dm=1,rm=1,after=raw,formula="Чистый урон обходит защиту; снижение урона не применяется.";if(type!=="true"){let pre=type==="physical"?"p":"m",def=(type==="physical"?d.stats.physical_defense:d.stats.magic_defense)+(d.stats.hybrid_defense||0),drf=d.inputs[pre+"drf"],drp=d.inputs[pre+"drp"],pp=a.inputs[pre==="p"?"pp":"mpct"],pf=a.inputs[pre==="p"?"pf":"mf"];eff=Math.max(-60,(def-drf)*(1-drp/100)*(1-pp/100)-pf);dm=120/(120+eff);rm=1-d.inputs.dr/100;after=raw*dm*rm;formula="Снижение защиты → процентное пробивание → плоское пробивание → множитель 120/(120 + защита) → общее снижение урона."}$("#calc-result").innerHTML='<div class="overline">РЕЗУЛЬТАТ · '+esc(status(r.verification?.status))+'</div><div class="result-number">'+after.toFixed(1)+' <small style="font-size:13px">урона</small></div><div class="result-detail">До защиты: '+raw.toFixed(1)+' · Эффективная защита: '+(type==="true"?"—":eff.toFixed(2))+' · Множитель защиты: '+dm.toFixed(3)+' · Снижение урона: '+rm.toFixed(3)+'<br>'+formula+'<br>'+esc(a.hero.name)+' против '+esc(d.hero.name)+' · Патч '+esc(r.patch?.version)+'</div><p class="muted">Баффы, заклинания, крит, щиты, пассивки и сложные эффекты не моделируются. Не является точной симуляцией клиента.</p>'}
