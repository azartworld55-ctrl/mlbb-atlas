
const DB={heroes:[],items:[],emblems:[],spells:[],skills:[]},$=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const K={fav:"atlas-fav-v2",build:"atlas-build-v2",tier:"atlas-tier-v2"},R={Tank:"Танк",Fighter:"Боец",Assassin:"Убийца",Mage:"Маг",Marksman:"Стрелок",Support:"Поддержка"},L={"exp lane":"EXP","gold lane":"Золото","mid lane":"Мид",jungle:"Лес",roam:"Роум"},C={Attack:"Атака",Magic:"Магия",Defense:"Защита",Movement:"Передвижение",Jungle:"Лес",Roaming:"Роум"};
const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])),read=(k,d)=>{try{return JSON.parse(localStorage.getItem(k)||JSON.stringify(d))}catch{return d}},write=(k,v)=>localStorage.setItem(k,JSON.stringify(v)),id=h=>h.slug||h.id,hero=x=>DB.heroes.find(h=>id(h)===x||h.id===x),item=x=>DB.items.find(i=>i.id===x||i.slug===x),source=x=>x?.provenance?.source||x?.sources?.[0]?.url||"",role=x=>R[x]||x||"—",lane=x=>L[String(x||"").toLowerCase()]||x||"—",status=x=>x==="verified"?"Проверено":x==="experimental"?"Экспериментально":"Сообщено источником",num=x=>{if(typeof x==="number")return x;if(typeof x!=="string")return null;let n=Number(x.replace("%","").trim());return Number.isFinite(n)?n:null};
let fav=new Set(read(K.fav,[])),builds=read(K.build,[]),tiers=read(K.tier,{S:[],A:[],B:[],C:[],D:[]}),roleFilter="all",laneFilter="all",favOnly=false,itemCat="all",library="emblems";
function toast(t){let e=$("#toast");e.textContent=t;e.classList.add("show");setTimeout(()=>e.classList.remove("show"),2200)}
function mods(groups){let o={};(groups||[]).forEach(g=>Object.entries(g||{}).forEach(([k,v])=>{let n=num(v);if(n!==null)o[k]=(o[k]||0)+n}));return o}
function chips(o){return Object.entries(o).map(([k,v])=>'<span class="stat-chip">'+esc(k.replaceAll("_"," "))+': +'+esc(v)+'</span>').join("")}
async function load(){try{let names=["heroes","items","emblems","spells","skills"],data=await Promise.all(names.map(n=>fetch("./data/"+n+".json").then(r=>{if(!r.ok)throw Error(n+" "+r.status);return r.json()})));names.forEach((n,i)=>DB[n]=data[i]);$("#metric-heroes").textContent=DB.heroes.length;$("#metric-items").textContent=DB.items.length;$("#metric-emblems").textContent=DB.emblems.length;$("#metric-skills").textContent=DB.skills.length;initSelects();initCalc();renderHeroes();renderItems();renderLibrary();renderBuilds();renderTier();renderCompare();bind()}catch(e){$("main").insertAdjacentHTML("afterbegin",'<div class="notice">Не удалось загрузить базу. Проверь публикацию GitHub Pages и обнови страницу.</div>');console.error(e)}}
function show(v){$$(".view").forEach(x=>x.classList.toggle("active",x.id==="view-"+v));$$(".nav-link").forEach(x=>x.classList.toggle("active",x.dataset.view===v));$("#main-nav").classList.remove("open");window.scrollTo({top:0,behavior:"smooth"});if(v==="calculator")skillOptions()}
function renderHeroes(){let q=$("#hero-search").value.toLocaleLowerCase("ru"),rows=DB.heroes.filter(h=>(roleFilter==="all"||(h.roles||[]).includes(roleFilter))&&(laneFilter==="all"||(h.lanes||[]).some(x=>String(x).toLowerCase()===laneFilter))&&(!favOnly||fav.has(id(h)))&&(!q||[h.name,id(h),...(h.roles||[]),...(h.lanes||[])].join(" ").toLocaleLowerCase("ru").includes(q))).sort((a,b)=>a.name.localeCompare(b.name,"ru"));$("#hero-count").textContent=rows.length+" / "+DB.heroes.length;$("#hero-empty").classList.toggle("hidden",!!rows.length);$("#hero-grid").innerHTML=rows.map(h=>{let k=id(h),src=h.assets?.portrait_url;return '<article class="hero-card" data-hero="'+esc(k)+'" tabindex="0"><div class="portrait">'+(src?'<img loading="lazy" src="'+esc(src)+'" alt="" onerror="this.style.display=\'none\'">':"")+'<span class="role-chip">'+esc(role(h.roles?.[0]))+'</span><button class="favorite '+(fav.has(k)?"saved":"")+'" data-fav="'+esc(k)+'">'+(fav.has(k)?"★":"☆")+'</button></div><div class="hero-info"><div class="hero-name">'+esc(h.name)+'</div><div class="hero-meta"><span>'+esc((h.roles||[]).map(role).join(" · "))+'</span><span>'+esc((h.lanes||[]).map(lane).join("/"))+'</span></div></div></article>'}).join("")}
