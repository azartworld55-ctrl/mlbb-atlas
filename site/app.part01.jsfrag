
const DB={heroes:[],items:[],emblems:[],spells:[],skills:[]},$=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const K={fav:"atlas-fav-v2",build:"atlas-build-v2",tier:"atlas-tier-v2"},R={Tank:"Танк",Fighter:"Боец",Assassin:"Убийца",Mage:"Маг",Marksman:"Стрелок",Support:"Поддержка"},L={"exp lane":"EXP","gold lane":"Золото","mid lane":"Мид",jungle:"Лес",roam:"Роум"},C={Attack:"Атака",Magic:"Магия",Defense:"Защита",Movement:"Передвижение",Jungle:"Лес",Roaming:"Роум"};
let LOC={heroes:{},items:{},spells:{},emblems:{},skill_names:{}};
const displayName=x=>x?.name_ru||x?.name||"—",displayText=(x,key)=>x?.[key+"_ru"]||x?.[key]||"",cleanGameText=v=>String(v??"").replace(/<br[^>]*>/gi,"\n").replace(/<[^>]*>/g,"").replace(/&nbsp;/gi," ").replace(/&amp;/gi,"&").replace(/&lt;/gi,"<").replace(/&gt;/gi,">").trim();
function applyLocalization(loc){LOC=loc||LOC;DB.heroes.forEach(h=>{const t=LOC.heroes?.[h.slug||h.id];if(!t)return;if(t.name)h.name_ru=t.name;(h.skills||[]).forEach(s=>{const z=t.skills?.[s.name];if(z){s.name_ru=z.name;s.description_ru=cleanGameText(z.description)}})});DB.spells.forEach(x=>{const t=LOC.spells?.[x.name];if(t){x.name_ru=t.name;x.summary_ru=t.summary}});DB.emblems.forEach(x=>{const t=LOC.emblems?.[x.name];if(t)x.name_ru=t});DB.skills.forEach(x=>{const map=LOC.skill_names?.[x.hero_id];if(map?.[x.skill_name])x.skill_name_ru=map[x.skill_name]})}
const hasFilterValue=(values,needle)=>Array.isArray(values)&&values.some(x=>String(x??"").split(",").some(v=>v.trim().toLowerCase()===String(needle).trim().toLowerCase()));
const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])),read=(k,d)=>{try{return JSON.parse(localStorage.getItem(k)||JSON.stringify(d))}catch{return d}},write=(k,v)=>localStorage.setItem(k,JSON.stringify(v)),id=h=>h.slug||h.id,hero=x=>DB.heroes.find(h=>id(h)===x||h.id===x),item=x=>DB.items.find(i=>i.id===x||i.slug===x),source=x=>x?.provenance?.source||x?.sources?.[0]?.url||"",role=x=>String(x||"").split(",").map(v=>v.trim()).filter(Boolean).map(v=>R[v]||v).join(" · ")||"—",lane=x=>L[String(x||"").toLowerCase()]||x||"—",status=x=>x==="verified"?"Проверено":x==="experimental"?"Экспериментально":"Сообщено источником",num=x=>{if(typeof x==="number")return x;if(typeof x!=="string")return null;let n=Number(x.replace("%","").trim());return Number.isFinite(n)?n:null};
let fav=new Set(read(K.fav,[])),builds=read(K.build,[]),tiers=read(K.tier,{S:[],A:[],B:[],C:[],D:[]}),roleFilter="all",laneFilter="all",favOnly=false,itemCat="all",library="emblems";
function toast(t){let e=$("#toast");e.textContent=t;e.classList.add("show");setTimeout(()=>e.classList.remove("show"),2200)}
function mods(groups){let o={};(groups||[]).forEach(g=>Object.entries(g||{}).forEach(([k,v])=>{let n=num(v);if(n!==null)o[k]=(o[k]||0)+n}));return o}
const STAT_LABELS={physical_attack:"Физическая атака",magic_power:"Магическая сила",attack_speed:"Скорость атаки",physical_defense:"Физическая защита",magic_defense:"Магическая защита",hybrid_defense:"Гибридная защита",hp:"Здоровье",movement_speed:"Скорость передвижения",cooldown_reduction:"Сокращение перезарядки",cd_reduction:"Сокращение перезарядки",crit_chance:"Шанс критического удара",crit_damage:"Критический урон",lifesteal:"Физическое похищение жизни",spell_vamp:"Магическое похищение жизни",magic_penetration:"Магическое пробивание",physical_penetration:"Физическое пробивание",adaptive_attack:"Адаптивная атака",hybrid_regen:"Гибридная регенерация",hp_regen:"Регенерация здоровья",healing_effect:"Эффект лечения"};
function chips(o){return Object.entries(o).map(([k,v])=>'<span class="stat-chip">'+esc(STAT_LABELS[k]||k.replaceAll("_"," "))+': +'+esc(v)+'</span>').join("")}
async function load(){try{let names=["heroes","items","emblems","spells","skills"],data=await Promise.all(names.map(n=>fetch("./data/"+n+".json").then(r=>{if(!r.ok)throw Error(n+" "+r.status);return r.json()})));names.forEach((n,i)=>DB[n]=data[i]);try{const lr=await fetch("./data/ru-localization.json");if(lr.ok)applyLocalization(await lr.json())}catch(e){console.warn("Русская локализация недоступна; показаны исходные названия.",e)}$("#metric-heroes").textContent=DB.heroes.length;$("#metric-items").textContent=DB.items.length;$("#metric-emblems").textContent=DB.emblems.length;$("#metric-skills").textContent=DB.skills.length;initSelects();initCalc();renderHeroes();renderItems();renderLibrary();renderBuilds();renderTier();renderCompare();bind();const sharedHero=heroFromHash();if(sharedHero&&hero(sharedHero)){show("heroes");openHero(sharedHero,true)}}catch(e){$("main").insertAdjacentHTML("afterbegin",'<div class="notice">Не удалось загрузить базу. Проверь публикацию GitHub Pages и обнови страницу.</div>');console.error(e)}}
function show(v){$$(".view").forEach(x=>x.classList.toggle("active",x.id==="view-"+v));$$(".nav-link").forEach(x=>x.classList.toggle("active",x.dataset.view===v));$("#main-nav").classList.remove("open");window.scrollTo({top:0,behavior:"smooth"});if(v==="calculator")skillOptions()}
function renderHeroes(){let q=$("#hero-search").value.toLocaleLowerCase("ru"),rows=DB.heroes.filter(h=>(roleFilter==="all"||hasFilterValue(h.roles,roleFilter))&&(laneFilter==="all"||hasFilterValue(h.lanes,laneFilter))&&(!favOnly||fav.has(id(h)))&&(!q||[h.name,h.name_ru,id(h),...(h.roles||[]),...(h.lanes||[])].join(" ").toLocaleLowerCase("ru").includes(q))).sort((a,b)=>displayName(a).localeCompare(displayName(b),"ru"));$("#hero-count").textContent=rows.length+" / "+DB.heroes.length;$("#hero-empty").classList.toggle("hidden",!!rows.length);$("#hero-grid").innerHTML=rows.map(h=>{let k=id(h),src=h.assets?.portrait_url;return '<article class="hero-card" data-hero="'+esc(k)+'" tabindex="0"><div class="portrait">'+(src?'<img loading="lazy" src="'+esc(src)+'" alt="" onerror="this.style.display=\'none\'">':"")+'<span class="role-chip">'+esc(role(h.roles?.[0]))+'</span><button class="favorite '+(fav.has(k)?"saved":"")+'" data-fav="'+esc(k)+'">'+(fav.has(k)?"★":"☆")+'</button></div><div class="hero-info"><div class="hero-name">'+esc(displayName(h))+'</div><div class="hero-meta"><span>'+esc((h.roles||[]).map(role).join(" · "))+'</span><span>'+esc((h.lanes||[]).map(lane).join("/"))+'</span></div></div></article>'}).join("")}
