{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlbb-atlas.example/schema/skill-version.schema.json",
  "title": "MLBB Atlas versioned skill record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "hero_id",
    "skill_id",
    "skill_name",
    "patch",
    "parameters",
    "verification",
    "sources"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "hero_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "skill_slot": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "channel",
        "effective_from",
        "effective_until"
      ],
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[a-z]?$"
        },
        "channel": {
          "enum": [
            "original_server",
            "advanced_server",
            null
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "values_by_skill_level",
          "value_semantics",
          "level_labels"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "base_damage",
              "scaling",
              "cooldown",
              "resource_cost",
              "duration",
              "slow",
              "heal",
              "shield",
              "other"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "damage_type": {
            "enum": [
              "physical",
              "magic",
              "true",
              "none",
              null
            ]
          },
          "values_by_skill_level": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "scaling_attribute": {
            "type": [
              "string",
              "null"
            ]
          },
          "scaling_basis": {
            "enum": [
              "total_physical_attack",
              "bonus_physical_attack",
              "total_magic_power",
              "max_hp",
              "current_hp",
              "target_max_hp",
              "none",
              null
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "value_semantics": {
            "enum": [
              "fixed",
              "endpoints",
              "per_level"
            ]
          },
          "level_labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_at",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "reported",
            "experimental",
            "verified",
            "unverified"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "url",
          "accessed_at"
        ],
        "properties": {
          "source_type": {
            "enum": [
              "official_patch_notes",
              "in_game_test",
              "official_game_client",
              "community_wiki",
              "upstream_dataset",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "raw_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
